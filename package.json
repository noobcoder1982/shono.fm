{
  "name": "shono-fm",
  "productName": "shono.fm",
  "description": "SHONO.FM — Precision Audio Archive",
  "author": "shono.fm",
  "private": true,
  "version": "1.3.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:build:app": "npm run build && electron-builder --win dir",
    "electron:build:installer": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config electron-builder-installer.json",
    "electron:build": "npm run electron:build:app && npm run electron:build:installer",
    "installer": "electron electron/installer.cjs",
    "mac:build": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@types/jszip": "^3.4.0",
    "@vercel/analytics": "^2.0.1",
    "gsap": "^3.15.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.44.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "fm.shono.desktop",
    "productName": "shono.fm",
    "directories": {
      "output": "dist-electron/app"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/discordRpc.cjs",
      "electron/icon.png",
      "package.json"
    ],
    "win": {
      "target": "dir",
      "icon": "electron/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "electron/icon.png",
      "category": "public.app-category.music",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "sign": false
    }
  }
}
