      "to": "app-payload"
    }
  ],
  "extraMetadata": {
    "name": "shono-fm-setup",
    "version": "1.3.0",
    "main": "electron/installer.cjs"
  },
  "win": {
    "icon": "build/icon.png",
    "target": "portable",
    "artifactName": "shono.fm.Setup.1.3.0.exe",
    "signAndEditExecutable": false
  }
}
